---
const W = 'https://3hsqhvhvojbpy1pz.public.blob.vercel-storage.com/main/hero.webp';
const opt = `/_vercel/image?url=${encodeURIComponent(W)}&w=1080&q=75`;
const box = 'position:relative;overflow:hidden;background:#121214;height:520px;margin-bottom:8px';
const img = 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover';
---
<html><head><meta name="viewport" content="width=device-width,initial-scale=1" /><title>hero test</title></head>
<body style="margin:0;font:16px sans-serif">
  <p>A: original webp, plain</p>
  <div style={box}><img style={img} src={W} alt="A" /></div>
  <p>B: jpeg (same origin)</p>
  <div style={box}><img style={img} src="/hero-test.jpg" alt="B" /></div>
  <p>C: webp via Vercel optimizer</p>
  <div style={box}><img style={img} src={opt} alt="C" /></div>
  <p>D: webp, plain, no object-fit</p>
  <div style={box}><img style="width:100%;display:block" src={W} alt="D" /></div>
</body></html>
