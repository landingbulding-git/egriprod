---
import App from '../components/App.tsx';
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>hero test 2</title>
    <style id="t"></style>
  </head>
  <body class="bg-[#F4EFE6] min-h-screen">
    <App client:load />
    <div id="bar" style="position:fixed;left:0;right:0;bottom:0;z-index:99999;background:#fff;border-top:2px solid #000;padding:6px;display:flex;flex-wrap:wrap;gap:6px;font:13px sans-serif">
      <button data-k="1">1 no blur/filters</button>
      <button data-k="2">2 no 3D transforms</button>
      <button data-k="3">3 no hero scrims</button>
      <button data-k="4">4 no hero toolbar</button>
      <button data-k="5">5 hide rest of page</button>
      <button data-k="0">reset</button>
    </div>
    <script is:inline>
      const css = {
        1: '*{filter:none!important;-webkit-backdrop-filter:none!important;backdrop-filter:none!important}',
        2: '[style*="perspective"]{transform:none!important}',
        3: 'section:first-of-type [class*="bg-gradient"]{display:none!important}',
        4: 'section:first-of-type [class*="backdrop-blur"]{display:none!important}',
        5: 'main > div ~ *{display:none!important}',
      };
      let on = {};
      document.getElementById('bar').addEventListener('click', (e) => {
        const k = e.target.dataset.k; if (k === undefined) return;
        if (k === '0') on = {}; else { on[k] = !on[k]; e.target.style.background = on[k] ? '#fc0' : ''; }
        document.getElementById('t').textContent = Object.keys(on).filter((x) => on[x]).map((x) => css[x]).join('\n');
      });
    </script>
  </body>
</html>
