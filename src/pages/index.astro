---
import App from '../components/App.tsx';
import '../styles/global.css';
---
<!doctype html>
<html lang="hu">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EgriProd – Saját dal egy hét alatt | Zeneszerzés, stúdió, Tiktok-sláger</title>
    <meta name="description" content="Profi dalszerzés, beat, felvétel és lyrics videó egy hét alatt. 0% lenyúlt jogdíj, a dal 100%-ban a tiéd. Csomagok 249.990 Ft-tól – beszéljünk 15 percet ingyen!" />
    <link rel="canonical" href="https://egriprod.hu/" />
    <meta name="theme-color" content="#0E0F14" />
    <meta property="og:title" content="Robbantsd fel a Tiktokot saját slágereddel" />
    <meta property="og:description" content="Az EgriProd all-in-one csapata egy hét alatt profi előadót farag belőled, miközben egyetlen forint jogdíjat sem nyúlunk le tőled." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="EgriProd" />
    <meta property="og:locale" content="hu_HU" />
    <meta property="og:url" content="https://egriprod.hu/" />
    <meta property="og:image" content="https://3hsqhvhvojbpy1pz.public.blob.vercel-storage.com/main/og.webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Robbantsd fel a Tiktokot saját slágereddel" />
    <meta name="twitter:description" content="Az EgriProd all-in-one csapata egy hét alatt profi előadót farag belőled, miközben egyetlen forint jogdíjat sem nyúlunk le tőled." />
    <meta name="twitter:image" content="https://3hsqhvhvojbpy1pz.public.blob.vercel-storage.com/main/og.webp" />
    <link rel="preconnect" href="https://3hsqhvhvojbpy1pz.public.blob.vercel-storage.com" />
    <link rel="icon" type="image/png" href="https://3hsqhvhvojbpy1pz.public.blob.vercel-storage.com/main/favicon.png" />
  </head>
  <body class="bg-[#F4EFE6] text-neutral-900 antialiased selection:bg-[#EAA824] selection:text-black min-h-screen">
    <App client:load />
  </body>
</html>
